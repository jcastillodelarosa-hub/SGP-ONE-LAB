      "md5": "7f175660ebd49d03ce44436e8169a95a",
      "definicion": "CREATE OR REPLACE FUNCTION public.sgp_mecanizado_validar_prioridad_nueva()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$ begin if new.prioridad_semanal is null then raise exception 'Prioridad semanal requerida'; end if; if not exists(select 1 from public.sgp_prioridades pr where pr.reserva=new.reserva and pr.prioridad=new.prioridad_semanal and pr.id_linea='PANELES_2') then raise exception 'Prioridad no corresponde a la reserva'; end if; return new; end $function$\n",
      "owner": "postgres",
      "execute": {
