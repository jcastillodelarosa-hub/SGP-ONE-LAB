{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "docs/**",
      "supabase/**",
      "tests/**",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "config.example.js",
      "README.md",
      "**/*.md",
      ".agents/**",
      "functions/**",
      "dataconnect/**",
      "scripts/**",
      "sql-test*",
      "**/.*",
      "**/*.sql"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
