{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "docs/**",
      "supabase/**",
      "tests/**",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "config.example.js",
      "README.md",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/sgp-gateway/**",
        "function": {
          "functionId": "sgpGateway",
          "region": "us-east1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
